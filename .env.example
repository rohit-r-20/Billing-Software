# ==============================================================================
# Alpha Billing ERP - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your local or cloud database connection.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE ENVIRONMENT & CONNECTION STRING
# ------------------------------------------------------------------------------
# Active environment tier: development | testing | production
DATABASE_ENV=development

# The primary database connection string used by SQLAlchemy 2.x, Alembic & Psycopg 3.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=...

# OPTION A: Supabase PostgreSQL (Development & Testing)
# Recommended for persistent Python desktop connections:
# 1. Supabase Session Pooler (port 5432, pooling mode: session):
#    DATABASE_URL=postgresql+psycopg://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# 2. Supabase Direct Connection (port 5432, requires IPv6 network):
#    DATABASE_URL=postgresql+psycopg://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres?sslmode=require

# OPTION B: Self-Managed / On-Premise PostgreSQL (Production Deployment)
# DATABASE_URL=postgresql+psycopg://alpha_user:[YOUR_PASSWORD]@db.alphabilling.internal:5432/alpha_billing_prod?sslmode=verify-full

# OPTION C: Local PostgreSQL Development Database
# DATABASE_URL=postgresql+psycopg://localhost:5432/alpha_billing_dev

# OPTION D: Historical SQLite Fallback (used when DATABASE_URL is commented out)
# DATABASE_URL=sqlite:///data/anti_matrix_billing.db

# ------------------------------------------------------------------------------
# 2. CONNECTION POOLING PARAMETERS (SQLAlchemy 2.x)
# ------------------------------------------------------------------------------
# Conservative defaults tailored for desktop clients connecting to cloud databases:
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# ------------------------------------------------------------------------------
# 3. APPLICATION & LOGGING SETTINGS
# ------------------------------------------------------------------------------
APP_ENV=development
APP_LOG_LEVEL=INFO
