# ==============================================================================
# Alpha Billing - Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your database connection parameters.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# The primary database connection string used by SQLAlchemy 2.x, Alembic & Psycopg 3.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=...

# Option A: Supabase-Hosted PostgreSQL (Development & Testing)
# Connect using Supabase Transaction Pooler (port 6543) or Direct Connection (port 5432):
DATABASE_URL=postgresql+psycopg://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Option B: Self-Managed PostgreSQL (Production Deployment)
# DATABASE_URL=postgresql+psycopg://alpha_user:YOUR_SECURE_PASSWORD@db.alphabilling.internal:5432/alpha_billing_prod?sslmode=verify-full

# Option C: Local SQLite Fallback (used when DATABASE_URL is commented out)
# DATABASE_URL=sqlite:///data/anti_matrix_billing.db

# ------------------------------------------------------------------------------
# 2. SUPABASE PROJECT DETAILS (Optional - Python Backend Only)
# ------------------------------------------------------------------------------
# These are kept strictly within the Python backend environment and never exposed
# to client JavaScript, HTML, or QWebChannel.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ------------------------------------------------------------------------------
# 3. APPLICATION & OPERATIONAL SETTINGS
# ------------------------------------------------------------------------------
APP_ENV=development
APP_LOG_LEVEL=INFO
