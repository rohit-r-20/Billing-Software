# ==============================================================================
# Anti-Matrix Billing V2 — Staging Environment Configuration Template (.env.staging)
# ==============================================================================
# Copy this file to .env on your staging server or staging test machine.
# DO NOT deploy to production. DO NOT use real customer or production financial data.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT IDENTIFIER
# ------------------------------------------------------------------------------
# Active tier MUST be set to 'staging'.
APP_ENV=staging
DATABASE_ENV=staging

# ------------------------------------------------------------------------------
# 2. FAST BILLING (POS) STAGING DATABASE
# ------------------------------------------------------------------------------
# OPTION A: Isolated Local Staging SQLite Database (Default)
# When DATABASE_URL is left unset or set to the staging path below:
DATABASE_URL=sqlite:///data/staging_anti_matrix_billing.db

# OPTION B: Dedicated Cloud / On-Premise Staging PostgreSQL
# DATABASE_URL=postgresql+psycopg://staging_user:STAGING_PASS@staging-db.internal:5432/staging_pos_db?sslmode=require

# ------------------------------------------------------------------------------
# 3. TRADITIONAL ERP BILLING STAGING DATABASE
# ------------------------------------------------------------------------------
# Must remain strictly isolated from Fast Billing.
# OPTION A: Isolated Local Staging SQLite Database (Default)
TRADITIONAL_DATABASE_URL=sqlite:///data/staging_traditional_billing.db

# OPTION B: Dedicated Cloud / On-Premise Staging PostgreSQL
# TRADITIONAL_DATABASE_URL=postgresql+psycopg://staging_user:STAGING_PASS@staging-db.internal:5432/staging_erp_db?sslmode=require

# ------------------------------------------------------------------------------
# 4. DATABASE CONNECTION POOLING (PostgreSQL Staging Only)
# ------------------------------------------------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# ------------------------------------------------------------------------------
# 5. APPLICATION LOGGING & DIAGNOSTICS
# ------------------------------------------------------------------------------
APP_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 6. STAGING SEED DATA TOGGLE
# ------------------------------------------------------------------------------
# Set to 1 to seed synthetic retail products and demo accounts on fresh staging DB.
STAGING_SEED_DEMO_DATA=1
